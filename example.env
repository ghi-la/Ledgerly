# --- The only two values you must set ---------------------------------------
# MongoDB Atlas connection string. Replace <db_username> / <db_password>.
# Add the database name after the host (here: "ledgerly"), otherwise Atlas
# uses "test".
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster_name>.zrsoj.mongodb.net/<database_name>?retryWrites=true&w=majority&appName=<app_name>"

# Session encryption key. Generate one with: openssl rand -base64 32
AUTH_SECRET="<your_auth_secret>"

# Server-held key that wraps every user's transaction-field data-encryption
# key (DEK). Required — the server uses this to decrypt description/merchant/
# notes for search, rules, and display regardless of client session state.
# Generate one with: openssl rand -base64 32
# Never rotate this without first re-wrapping every user's DEK with the new
# key, or their encrypted transactions become permanently unreadable.
ENCRYPTION_MASTER_KEY="<your_encryption_master_key>"

# --- Optional ---------------------------------------------------------------
# Set to "false" to close public sign-ups once your accounts exist.
ALLOW_REGISTRATION="true"

# Resend API key (resend.com, free tier: 100 emails/day, no card required),
# used to send the "confirm your email" link on registration. Without it,
# the link is only logged to the server console (fine for local dev, not
# for a real deployment - unverified accounts can't sign in either way).
RESEND_API_KEY="<your_resend_api_key>"
# Sender shown on the confirmation email. Requires ledgerly.ghila.xyz to be
# added and verified as a domain in the Resend dashboard first (see README);
# until that verification goes green, sends from this address will fail and
# fall back to being logged server-side rather than delivered.
EMAIL_FROM="<your_email_from_address>"
